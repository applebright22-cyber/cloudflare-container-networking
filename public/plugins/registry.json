{
  "platform": "VampireSquid",
  "schema_version": 1,
  "runtime": "TinyCore Linux",
  "plugins": [
    {
      "id": "network-inspector",
      "name": "Network Inspector",
      "version": "1.1.0",
      "entrypoint": "network-inspector.sh",
      "capabilities": [
        "interfaces.read",
        "routes.read",
        "dns.inspect",
        "reachability.check",
        "dns.google_fallback"
      ]
    },
    {
      "id": "dhcp-lab",
      "name": "DHCP Lab",
      "version": "1.0.0",
      "entrypoint": "dhcp-lab.sh",
      "capabilities": [
        "dhcp.lease.inspect",
        "dhcp.lease.renew"
      ]
    },
    {
      "id": "backend-starter",
      "name": "Backend Starter",
      "version": "1.0.0",
      "entrypoint": "backend-starter.sh",
      "capabilities": [
        "webapp.scaffold",
        "http.server.local"
      ]
    },
    {
      "id": "oracle-bridge-status",
      "name": "Oracle Bridge Connector",
      "version": "1.0.0",
      "entrypoint": "oracle-bridge-status.sh",
      "capabilities": [
        "oracle.bridge.status.read",
        "cloudflare.worker.fetch"
      ]
    },
    {
      "id": "android-companion",
      "name": "Android Companion (Termux)",
      "version": "1.0.0",
      "runtime": "android-termux",
      "entrypoint": "android-companion.sh",
      "capabilities": [
        "android.device.info.read",
        "android.network.inspect",
        "dns.google.doh"
      ]
    }
  ],
  "runtime_support": [
    "tinycore-linux",
    "android-termux"
  ]
}
