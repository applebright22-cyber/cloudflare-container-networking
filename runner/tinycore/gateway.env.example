# Tiny Core FineProxy/Mysterium gateway settings.
# Copy to /etc/cloudflare-node/gateway.env at deployment time.
# NEVER commit real FineProxy credentials.

WAN_INTERFACE=eth0
LAN_INTERFACE=eth1
LAN_ADDRESS=10.240.0.1
LAN_NETMASK=255.255.255.0
DHCP_START=10.240.0.2
DHCP_END=10.240.0.101
DHCP_LEASE=86400

# One mapping per MystNode. Do not put credentials in this repository.
# NODE_1_IP=10.240.0.2
# NODE_1_PROXY_HOST=proxy.example
# NODE_1_PROXY_PORT=1080
# NODE_1_PROXY_USER=
# NODE_1_PROXY_PASSWORD=
# NODE_1_TCP_PORTS=4444
# NODE_1_UDP_PORTS=4444
