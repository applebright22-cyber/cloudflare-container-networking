# Copy this file to the persistent Tiny Core configuration directory as node.env.
# Do not commit real values here.
NODE_ID=replace-with-node-id
CLOUDFLARE_API_URL=https://YOUR-WORKER.workers.dev
NODE_INTERFACE=eth0
MYST_BIN=/opt/mysterium/myst
MYST_DATA_DIR=/var/lib/mysterium-node
RUNNER_POLL_SECONDS=5
RUNNER_HEARTBEAT_SECONDS=10
